# imagegen-service — ComfyUI-fronting image API. systemd unit, GENERATED by install/install-linux.sh.
# Do not edit the copy under /etc/systemd/system by hand; re-run the installer instead.
# Placeholders (@USER@, @REPO@, @NODE@, @NODEBIN@) are substituted with this machine's real values.
#
# All runtime config (comfyui.url, server.host/port, the optional auth token) is read from the
# repo's config.json by the app itself — NOT from this unit. Do NOT put secrets or paths here.
#
# NODE PATH IS nvm-VERSION-SPECIFIC. systemd runs with a bare PATH and does NOT see your login
# shell / nvm, so `npm` and a bare `node` are invisible to it (ExecStart=/usr/bin/npm fails with
# status=203/EXEC). The installer therefore resolves `node` to its ABSOLUTE path (`command -v node`)
# and writes it below. If you upgrade node, re-run the installer to regenerate this unit.

[Unit]
Description=imagegen-service (ComfyUI-fronting image API)
After=network-online.target comfyui.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@

# Absolute node path (nvm-version-specific — see header). @NODEBIN@ is node's bin dir so any child
# process the app spawns can still find node's siblings (npm, etc.).
Environment=PATH=@NODEBIN@:/usr/bin:/bin
ExecStart=@NODE@ --import tsx src/index.ts

Restart=on-failure
RestartSec=5

# Give an in-flight /generate room to finish on stop before SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
