# ComfyUI local image-gen service (SDXL) — GENERATED by install/install-linux.sh.
# Do not edit the copy under /etc/systemd/system by hand; re-run the installer instead.
# Placeholders (@USER@, @COMFYUI@) are substituted with this machine's real values at install time.
#
# Runs ComfyUI headless from its isolated uv Python 3.11 venv, restart-on-crash, start-on-boot.
#
# NOTE: --listen 0.0.0.0 exposes an UNAUTHENTICATED ComfyUI to the LAN. Narrow to 127.0.0.1 if
# local-only is ever wanted.

[Unit]
Description=ComfyUI local image-gen service (SDXL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@COMFYUI@
ExecStart=@COMFYUI@/.venv/bin/python @COMFYUI@/main.py --listen 0.0.0.0 --port 8188
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
