# secrets.env — download-time secrets for the installers/fetch scripts. NOT committed.
#
# Copy this file to `install/secrets.env` and fill in your token. `install/secrets.env` is
# gitignored so your key never lands in git. Nothing in the running service (src/) ever reads this
# — it is used ONLY while downloading models, and ONLY for civitai.com (never sent to Hugging Face
# or any other host).
#
# The installers also accept the token two other ways; precedence is:
#   1. --civitai-token <key>   (command-line flag)
#   2. CIVITAI_TOKEN=<key>     (environment variable, shell installer only)
#   3. this file
#
# Get a key at https://civitai.com/user/account (API Keys). Only needed for models whose Civitai
# download is login-gated; entries with an ungated Hugging Face mirror work without it.

CIVITAI_TOKEN=
